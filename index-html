    justify-content:space-between;
    align-items:center;
    flex-wrap:wrap;
    gap:20px;
}

footer p{
    color:#666;
}

.social{
    display:flex;
    gap:10px;
}

.social a{
    width:40px;
    height:40px;
    display:flex;
    align-items:center;
    justify-content:center;
    border-radius:50%;
    background:#ffffff08;
    color:white;
    text-decoration:none;
    transition:.3s;
}

.social a:hover{
    background:#7c00ff;
    box-shadow:0 0 15px #7c00ff;
}

/* Mobile */

@media(max-width:1000px){
    .hero{
        flex-direction:column;
        text-align:center;
    }

    .hero-buttons{
        justify-content:center;
    }

    .stats{
        grid-template-columns:repeat(2,1fr);
    }

    .games{
        grid-template-columns:repeat(2,1fr);
    }

    .tournaments{
        grid-template-columns:1fr;
    }

    .hero-card{
        width:90%;
        max-width:430px;
    }
}

@media(max-width:700px){

    nav{
        padding:0 4%;
    }

    .nav-links{
        display:none;
    }

    .logo{
        font-size:18px;
    }

    section{
        padding:70px 5%;
    }

    .stats,
    .games{
        grid-template-columns:1fr;
    }

    .hero h1{
        font-size:45px;
    }

    .join h2{
        font-size:28px;
    }
}
</style>
</head>

