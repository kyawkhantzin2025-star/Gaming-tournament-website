<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>NEON ARENA | Gaming Tournament</title>

<style>
@import url('https://fonts.googleapis.com/css2?family=Orbitron:wght@400;500;600;700;800;900&family=Poppins:wght@300;400;500;600;700;800&display=swap');

*{
    margin:0;
    padding:0;
    box-sizing:border-box;
    scroll-behavior:smooth;
}

body{
    font-family:'Poppins',sans-serif;
    background:#050510;
    color:white;
    overflow-x:hidden;
}

/* Animated Background */
body::before{
    content:"";
    position:fixed;
    width:600px;
    height:600px;
    background:#7c00ff;
    filter:blur(180px);
    opacity:.18;
    top:-200px;
    left:-200px;
    z-index:-2;
}

body::after{
    content:"";
    position:fixed;
    width:500px;
    height:500px;
    background:#00eaff;
    filter:blur(180px);
    opacity:.12;
    right:-150px;
    bottom:-100px;
    z-index:-2;
}

/* Navbar */

nav{
    position:fixed;
    top:0;
    width:100%;
    height:75px;
    display:flex;
    align-items:center;
    justify-content:space-between;
    padding:0 7%;
    background:rgba(5,5,16,.75);
    backdrop-filter:blur(15px);
    border-bottom:1px solid rgba(255,255,255,.08);
    z-index:1000;
}

.logo{
    font-family:'Orbitron';
    font-size:24px;
    font-weight:900;
    color:#00f7ff;
    text-shadow:0 0 15px #00f7ff;
}

.logo span{
    color:#ff00e6;
}

.nav-links{
    display:flex;
    gap:25px;
    list-style:none;
}

.nav-links a{
    color:#ddd;
    text-decoration:none;
    font-size:14px;
    transition:.3s;
}

.nav-links a:hover{
    color:#00f7ff;
    text-shadow:0 0 10px #00f7ff;
}

.nav-buttons{
    display:flex;
    gap:10px;
}

.btn{
    border:none;
    padding:11px 20px;
    border-radius:8px;
    font-weight:700;
    cursor:pointer;
    transition:.3s;
    text-decoration:none;
    display:inline-block;
}

.btn-login{
    background:transparent;
    color:#fff;
    border:1px solid #00eaff;
}

.btn-register{
    background:linear-gradient(90deg,#00eaff,#7b00ff,#ff00cc);
    color:white;
    box-shadow:0 0 15px #7b00ff;
}

.btn:hover{
    transform:translateY(-3px) scale(1.03);
}

/* Hero */

.hero{
    min-height:100vh;
    padding:150px 8% 80px;
    display:flex;
    align-items:center;
    justify-content:space-between;
    gap:50px;
}

.hero-content{
    max-width:650px;
}

.badge{
    display:inline-block;
    padding:8px 16px;
    border:1px solid #ff00d4;
    color:#ff55e8;
    border-radius:30px;
    margin-bottom:20px;
    box-shadow:0 0 15px #ff00d433;
    font-size:13px;
}

.hero h1{
    font-family:'Orbitron';
    font-size:clamp(45px,7vw,85px);
    line-height:1.05;
    margin-bottom:25px;
}

.gradient-text{
    background:linear-gradient(90deg,#00eaff,#7c00ff,#ff00d4,#ffea00);
    background-size:300%;
    -webkit-background-clip:text;
    color:transparent;
    animation:gradient 5s infinite;
}

@keyframes gradient{
    0%{background-position:0%}
    50%{background-position:100%}
    100%{background-position:0%}
}

.hero p{
    color:#aaa;
    line-height:1.8;
    margin-bottom:30px;
}

.hero-buttons{
    display:flex;
    gap:15px;
    flex-wrap:wrap;
}

.main-btn{
    background:linear-gradient(90deg,#00eaff,#7c00ff);
    color:white;
    box-shadow:0 0 25px #4d00ff88;
}

.outline-btn{
    border:1px solid #ff00cc;
    color:white;
    background:#ff00cc12;
}

.hero-card{
    width:430px;
    height:500px;
    border-radius:25px;
    padding:3px;
    background:linear-gradient(135deg,#00eaff,#7c00ff,#ff00cc,#ffe600);
    box-shadow:0 0 60px #6200ff55;
    animation:float 4s ease-in-out infinite;
}

.hero-card-inner{
    width:100%;
    height:100%;
    border-radius:22px;
    background:#0b0b18;
    display:flex;
    flex-direction:column;
    justify-content:center;
    align-items:center;
    text-align:center;
}

.hero-icon{
    font-size:120px;
    filter:drop-shadow(0 0 20px #00eaff);
}

.hero-card h2{
    font-family:'Orbitron';
    margin:20px 0 10px;
}

.hero-card p{
    color:#888;
}

@keyframes float{
    0%,100%{transform:translateY(0)}
    50%{transform:translateY(-15px)}
}

/* Sections */

section{
    padding:90px 8%;
}

.section-title{
    text-align:center;
    margin-bottom:50px;
}

.section-title h2{
    font-family:'Orbitron';
    font-size:35px;
}

.section-title p{
    color:#888;
    margin-top:10px;
}

/* Stats */

.stats{
    display:grid;
    grid-template-columns:repeat(4,1fr);
    gap:20px;
}

.stat{
    padding:30px;
    background:#0d0d1b;
    border:1px solid #ffffff12;
    border-radius:15px;
    text-align:center;
    transition:.3s;
}

.stat:hover{
    transform:translateY(-8px);
    border-color:#00eaff;
    box-shadow:0 0 25px #00eaff22;
}

.stat h2{
    font-size:35px;
    color:#00eaff;
    font-family:'Orbitron';
}

.stat p{
    color:#888;
}

/* Games */

.games{
    display:grid;
    grid-template-columns:repeat(4,1fr);
    gap:20px;
}

.game{
    height:220px;
    position:relative;
    overflow:hidden;
    border-radius:18px;
    background:linear-gradient(145deg,#111124,#080812);
    border:1px solid #ffffff12;
    transition:.4s;
}

.game:hover{
    transform:translateY(-10px);
    border-color:#ff00dd;
    box-shadow:0 0 30px #ff00dd33;
}

.game-icon{
    font-size:75px;
    text-align:center;
    padding-top:30px;
}

.game h3{
    text-align:center;
    font-family:'Orbitron';
}

.game button{
    display:block;
    margin:12px auto;
    background:#ffffff0d;
    color:white;
    border:1px solid #00eaff;
    padding:7px 18px;
    border-radius:20px;
    cursor:pointer;
}

/* Tournament */

.tournaments{
    display:grid;
    grid-template-columns:repeat(3,1fr);
    gap:25px;
}

.tournament{
    background:#0c0c19;
    border:1px solid #ffffff12;
    border-radius:18px;
    padding:25px;
    transition:.3s;
}

.tournament:hover{
    transform:translateY(-8px);
    box-shadow:0 0 30px #7c00ff33;
}

.tournament-top{
    display:flex;
    justify-content:space-between;
    margin-bottom:20px;
}

.tag{
    padding:5px 10px;
    border-radius:15px;
    background:#00eaff15;
    color:#00eaff;
    font-size:11px;
}

.prize{
    color:#ffe600;
}

.tournament h3{
    font-family:'Orbitron';
    margin-bottom:15px;
}

.tournament-info{
    color:#888;
    line-height:2;
    font-size:14px;
}

.tournament button{
    width:100%;
    margin-top:20px;
    padding:12px;
    border:none;
    border-radius:8px;
    background:linear-gradient(90deg,#ff00cc,#7c00ff);
    color:white;
    font-weight:bold;
    cursor:pointer;
}

/* Leaderboard */

.table-box{
    overflow-x:auto;
    background:#0b0b17;
    border-radius:18px;
    border:1px solid #ffffff10;
}

table{
    width:100%;
    border-collapse:collapse;
}

th,td{
    padding:18px;
    text-align:left;
    border-bottom:1px solid #ffffff09;
}

th{
    color:#00eaff;
    font-family:'Orbitron';
    font-size:13px;
}

td{
    color:#ccc;
}

.rank{
    color:#ffe600;
    font-family:'Orbitron';
}

/* Countdown */

.countdown{
    margin-top:30px;
    display:flex;
    gap:12px;
}

.time-box{
    background:#080815;
    border:1px solid #7c00ff;
    border-radius:10px;
    padding:15px;
    min-width:75px;
    text-align:center;
}

.time-box strong{
    display:block;
    font-size:25px;
    color:#00eaff;
    font-family:'Orbitron';
}

.time-box span{
    color:#777;
    font-size:10px;
}

/* Join */

.join{
